# LLM Provider: openai | anthropic | ollama
# The LLM is only needed by the Oracle tab; encyclopedia and map work without a key.
LLM_PROVIDER=openai
# Model name of the chosen provider (e.g. gpt-4o-mini for openai, llama3.1 for ollama)
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings & Reranker (local models, downloaded on first use; a few GB of RAM)
EMBEDDING_MODEL=BAAI/bge-m3
# cpu | cuda | empty = auto
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Cross-encoder reranker + relevance threshold ("джерела мовчать" below MIN_RELEVANCE)
RERANK_ENABLED=false

# Retrieval settings
RETRIEVE_K=20
CONTEXT_K=5
# Tune on the golden set
MIN_RELEVANCE=0.3
# Chat turns used to rewrite follow-up questions
HISTORY_TURNS=6

# Public demo protection
MAX_QUESTION_CHARS=500
MAX_QUESTIONS_PER_SESSION=30

# Storage paths (generated, gitignored)
DB_PATH=delphi.db
INDEX_DIR=index
DATA_DIR=data
