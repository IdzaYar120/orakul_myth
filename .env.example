# LLM Provider: openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings & Reranker
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=false

# Retrieval settings
RETRIEVE_K=20
CONTEXT_K=5
MIN_RELEVANCE=0.3

# Storage paths
DB_PATH=delphi.db
INDEX_DIR=index
