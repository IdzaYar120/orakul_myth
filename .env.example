# LLM: a local model via Ollama (https://ollama.com), no external API or key.
# Install Ollama, then: ollama pull hf.co/INSAIT-Institute/MamayLM-Gemma-3-12B-IT-v1.0-GGUF:Q4_K_M
# MamayLM = Gemma 3 12B tuned for Ukrainian (~7.3 GB; on an 8 GB GPU ~1/3 runs on CPU, ~25 s per answer).
# Lighter/faster but weaker Ukrainian: qwen2.5:7b
# (openai | anthropic are also supported, with OPENAI_API_KEY / ANTHROPIC_API_KEY)
LLM_PROVIDER=ollama
LLM_MODEL=hf.co/INSAIT-Institute/MamayLM-Gemma-3-12B-IT-v1.0-GGUF:Q4_K_M
OLLAMA_BASE_URL=http://localhost:11434
# Context window in tokens (Ollama's default 2048 is too small for 5 passages)
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings & Reranker (local models, downloaded on first use; a few GB of RAM)
EMBEDDING_MODEL=BAAI/bge-m3
# cpu | cuda | empty = auto
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Cross-encoder reranker on the English query + relevance threshold: below MIN_RELEVANCE
# the oracle refuses before generating (golden set at 0.05: 5/8 traps refused, 3/72 answerable
# lost). Off by default: +7.5 s per question on CPU; worth it on a GPU server.
RERANK_ENABLED=false
RERANK_CANDIDATES=8

# Retrieval settings
RETRIEVE_K=20
CONTEXT_K=5
# Only used with the reranker
MIN_RELEVANCE=0.05
# Translate the question to English for retrieval (local LLM, ~2 s; Hit@5 61% -> 71%)
QUERY_TRANSLATION=true
# Boost for passages tagged with the entities named in the question
ENTITY_BOOST=0.5
# Chat turns used to rewrite follow-up questions
HISTORY_TURNS=6

# Public demo protection
MAX_QUESTION_CHARS=500
MAX_QUESTIONS_PER_SESSION=30

# Storage paths (generated, gitignored)
DB_PATH=delphi.db
INDEX_DIR=index
DATA_DIR=data

# HTTP API (`delphi serve`): backend of the website and the mobile app
# local  = answer here (Ollama + index: your PC / a GPU server)
# remote = forward oracle requests to ORACLE_BACKEND_URL (public host without ML, PC via tunnel)
# off    = encyclopedia and map only
ORACLE_MODE=local
ORACLE_BACKEND_URL=
# Shared secret between the public API and the oracle node (header X-Oracle-Token).
# REQUIRED on an oracle exposed through a tunnel; generate e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
ORACLE_TOKEN=
# Questions per client IP per hour (0 = unlimited)
ORACLE_RATE_LIMIT=30
# Load the embedding model at startup (no ~30 s wait on the first question)
ORACLE_WARMUP=true
# Origins of the web/mobile frontends allowed to call the API (comma-separated)
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
